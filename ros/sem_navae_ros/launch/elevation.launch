<?xml version="1.0"?>
<launch>

    <arg name="vis" default="false"/>

    <node name="odom2pose" pkg="sem_navae_ros" type="tf_to_pose_publisher.py" output="screen"/>

    <node pkg="elevation_mapping" type="elevation_mapping" name="elevation_mapping" output="screen">
        <rosparam command="load" file="$(find sem_navae_ros)/config/elevation_mapping.yaml"/>
        <rosparam command="load" file="$(find sem_navae_ros)/config/postprocessor_pipeline.yaml"/>
    </node>

    <!-- Elevation collision filter (Eq. 6): raw candidates in, filtered candidates out. -->
    <node name="collision_filter" pkg="sem_navae_ros" type="grid_map_collisions" output="screen">
        <rosparam command="load" file="$(find sem_navae_ros)/config/sem_navae.yaml"/>
        <remap from="elevation_map"     to="/elevation_mapping/elevation_map"/>
        <remap from="trajectories"      to="/sem_navae/trajectories"/>
        <remap from="trajectories_filt" to="/sem_navae/trajectories_filt"/>
    </node>


    <group if="$(arg vis)">
        <!-- Launch visualizations for the resulting elevation map -->
        <include file="$(find elevation_mapping_demos)/launch/visualization.launch" />
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find elevation_mapping_demos)/rviz/elevation_map_visualization.rviz" />
    </group>

</launch>
